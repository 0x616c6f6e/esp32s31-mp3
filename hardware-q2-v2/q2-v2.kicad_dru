(version 1)
# JLCPCB published capabilities: via hole-to-copper >=0.20 mm,
# plated component hole-to-copper >=0.30 mm on inner layers.
# Via annulus is 0.125 mm, nominal via-copper spacing 0.10 mm gives 0.225 mm.
(rule "NPTH copper clearance"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.25mm)))
(rule "Plated component drill clearance"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.30mm)))
