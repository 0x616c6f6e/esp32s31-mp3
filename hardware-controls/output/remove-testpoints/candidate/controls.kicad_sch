	(text "U2 P4..P7 share R13 pull-down. Keep 0x03 = 0xFF (all inputs).\nPolarity 0x02 = 0x00; read 0x00, pressed = (~value) & 0x0F.\nINT_N is wired-OR: read BOTH devices until interrupt releases.\nRESET_N resets both ICs; reinitialize both after reset."
		(exclude_from_sim no)
		(at 15.24 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "280ca0c1-1518-5347-a49e-b6fdf4d097dc")
	)
