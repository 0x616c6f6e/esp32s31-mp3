	(text "Enable wheel: register 0x0E = 0xC0. Disable unused KEY3..11.\nFirmware configuration and final-cover calibration are required.\nElectrode shape includes switch clearances; verify 360-degree tracking."
		(exclude_from_sim no)
		(at 248.92 93.98 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "8c0fd401-a820-5c68-a268-947687bfe220")
	)
	(text "J1 is reserved for a future host. No mainboard connection in this revision.\nSupply regulated 3.3 V at J1 for bench testing.\nDo not apply battery voltage to the 3.3 V rail."
